# ============================================================
# AI LP Studio — 環境変数サンプル
# このファイルを .env.local にコピーして値を埋めてください
# cp .env.local.example .env.local
# ============================================================

# ─── Anthropic (必須) ────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (必須) ─────────────────────────────────────────
# Supabase ダッシュボード → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ↓ サーバー側のみ使用。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── アプリURL (必須) ────────────────────────────────────────
# ローカル開発: http://localhost:3000
# 本番: https://your-app.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Square 決済 (必須) ──────────────────────────────────────
# https://developer.squareup.com → Credentials
# SQUARE_ENV: sandbox（開発）または production（本番）
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=EAAAl...
SQUARE_LOCATION_ID=LXXXXXXXXXXXXXXXX
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key
# Square カタログ → サブスクリプションプラン → Pro プランの Variation ID
SQUARE_PRO_PLAN_VARIATION_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Resend メール通知 (必須) ────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Resendで確認済みドメインのアドレス（省略時: noreply@example.com）
FROM_EMAIL=noreply@yourdomain.com

# ─── Google Sheets 連携 (任意) ───────────────────────────────
# 未設定の場合はフォーム送信時の Sheets 書き込みをスキップ
# GCP → IAM → サービスアカウント → JSON鍵を発行 → 1行に圧縮して貼り付け
# 例: {"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Unsplash 画像検索 (任意) ────────────────────────────────
# 未設定の場合は検索キーワードとリンクのみ表示（画像取得なし）
# https://unsplash.com/developers （無料・50 req/h）
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
